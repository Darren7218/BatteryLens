<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:gravity="center" android:width="56dp" android:height="72dp">
        <shape android:shape="rectangle">
            <solid android:color="#F5F7FA" />
            <corners android:radius="15dp" />
        </shape>
    </item>

    <item android:gravity="top|center_horizontal" android:top="15dp" android:width="20dp" android:height="8dp">
        <shape android:shape="rectangle">
            <solid android:color="#F5F7FA" />
            <corners android:radius="4dp" />
        </shape>
    </item>

    <item android:gravity="center" android:width="36dp" android:height="52dp">
        <shape android:shape="rectangle">
            <solid android:color="#79E2A0" />
            <corners android:radius="10dp" />
        </shape>
    </item>

    <item android:gravity="center_horizontal" android:top="34dp" android:width="20dp" android:height="6dp">
        <shape android:shape="rectangle">
            <solid android:color="#12321F" />
            <corners android:radius="3dp" />
        </shape>
    </item>

    <item android:gravity="center_horizontal" android:top="44dp" android:width="20dp" android:height="6dp">
        <shape android:shape="rectangle">
            <solid android:color="#12321F" />
            <corners android:radius="3dp" />
        </shape>
    </item>

    <item android:gravity="right|bottom" android:right="17dp" android:bottom="18dp" android:width="30dp" android:height="30dp">
        <shape android:shape="oval">
            <solid android:color="#00000000" />
            <stroke android:width="4dp" android:color="#67C0FF" />
        </shape>
    </item>

    <item android:gravity="right|bottom" android:right="8dp" android:bottom="10dp" android:width="16dp" android:height="5dp">
        <shape android:shape="rectangle">
            <solid android:color="#67C0FF" />
            <corners android:radius="3dp" />
        </shape>
    </item>
</layer-list>
